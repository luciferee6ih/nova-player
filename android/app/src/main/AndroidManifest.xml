                <action android:name="com.theluciferee.novaplayer.ACTION_PREV" />
                <action android:name="com.theluciferee.novaplayer.ACTION_SHUFFLE" />
                <action android:name="com.theluciferee.novaplayer.ACTION_REPEAT" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/player_widget_info" />
        </receiver>

