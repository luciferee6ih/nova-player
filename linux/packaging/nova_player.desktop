[Desktop Entry]
Version=1.0
Name=NOVA Player
GenericName=Music Player
Comment=A powerful offline music player.
Exec=nova_player %U
Terminal=false
Type=Application
Categories=AudioVideo;Audio;Player;
MimeType=audio/mpeg;audio/x-mpegurl;audio/x-scpls;audio/x-vorbis+ogg;audio/x-wav;audio/aac;audio/flac;audio/mp4;
Icon=nova_player
StartupNotify=true
